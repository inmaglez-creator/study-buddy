      "id": "avoir-etre",
      "titulo": "Grammar · avoir and être (singular)",
      "resumen": [
        "## avoir = to have",
        "j'ai (I have), tu as (you have), il/elle/on a (he/she/one has).",
        "We use avoir for age: **J'ai onze ans** = I am eleven (literally 'I have eleven years').",
        "",
        "## être = to be",
        "je suis (I am), tu es (you are), il/elle/on est (he/she/one is).",
        "Je suis fille unique. Il est grand."
      ],
      "notas": [
        {
          "seccion": "The two most important verbs",
          "tarjetas": [
            {
              "etiqueta": "🎒 avoir",
              "titulo": "to have",
              "puntos": [
                "**j'ai** = I have",
                "**tu as** = you have",
                "**il / elle / on a** = he / she / one has"
              ]
            },
            {
              "etiqueta": "🙂 être",
              "titulo": "to be",
              "puntos": [
                "**je suis** = I am",
                "**tu es** = you are",
                "**il / elle / on est** = he / she / one is"
              ]
            }
          ]
        },
        {
          "seccion": "Watch out!",
          "tarjetas": [
            {
              "etiqueta": "🎂 Age",
              "titulo": "Use avoir, not être",
              "puntos": [
